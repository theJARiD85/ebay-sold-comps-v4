# KeepFlip AI Mode provider
SERPAPI_API_KEY=

# Official eBay Browse API credentials used for active-listing counts
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US


# Server-only secret required by subscription police when it invokes this Function.
SELLER_QUOTA_INTERNAL_SECRET=

# Defaults to true. Set to false only for authenticated local/temporary testing.
KEEPFLIP_REQUIRE_QUOTA_GATEWAY=true
